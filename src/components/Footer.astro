---
import { languages, useTranslations } from '@/i18n/config'
import { getLocaleUrl, getLocale } from 'astro-i18n-aut'
const currentPath = Astro.url.pathname

const locale = getLocale(Astro.url) as LangKeys
const t = useTranslations(locale) 
---

<footer class="bg-white border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-6 pt-8 pb-6">
    <div class="flex justify-center">
      <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr] gap-12 max-w-4xl">
        <div>
          <h3 class="mb-4 text-gray-900">{t('footer.about')}</h3>
          <p class="text-sm text-gray-600">{t('footer.description')}</p>
        </div>
        <div>
          <h3 class="mb-4 text-gray-900">{t('footer.links')}</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            <li>
              <a href={getLocaleUrl('/begriffsliste/', locale)} class="hover:text-gray-900"
                >{t('footer.termList')}</a
              >
            </li>
            <li>
              <a
                href="https://www.bsvonline.ch/de/brandschutzvorschriften/projekt-bsv-2026"
                target="_blank"
                class="hover:text-gray-900"
                >{ t('footer.bsv') }</a
              >
            </li>
            <li>
              <a
                href="https://www.bsvonline.ch/de/ueber-uns"
                target="_blank"
                class="hover:text-gray-900"
                >{t('footer.vkf')}</a
              >
            </li>
          </ul>
        </div>
        <div>
          <h3 class="mb-4 text-gray-900">{t('footer.languages')}</h3>
          <ul class="space-y-2">
            {
              languages.map((lang) => (
                <li>
                  <a
                    href={getLocaleUrl(currentPath, lang.code)}
                    class="flex items-center gap-2"
                  >
                    <div set:html={lang.flag} class="w-4 h-3" />
                    <span class="text-sm text-gray-600 capitalize">
                      {lang.name}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
    <div
      class="border-t pt-6 mt-8 text-center text-sm text-gray-500 border-gray-200"
    >
      {t('footer.copyright')}
    </div>
  </div>
</footer>
