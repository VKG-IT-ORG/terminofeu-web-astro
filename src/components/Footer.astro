---
import { languages } from '@/i18n/config'
import { getLocaleUrl } from 'astro-i18n-aut'
const currentPath = Astro.url.pathname
---

<footer class="bg-white border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-6 pt-8 pb-6">
    <div class="flex justify-center">
      <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr] gap-12 max-w-4xl">
        <div>
          <h3 class="mb-4 text-gray-900">Über Terminofeu</h3>
          <p class="text-sm text-gray-600">
            Terminofeu enthält die Begriffe, die in Anhang 2 der Schweizerischen
            Brandschutzvorschriften definiert sind, in deutscher, französischer
            und italienischer Sprache. Darüber hinaus umfasst die
            Terminologiedatenbank weitere Fachbegriffe aus dem Bereich
            Brandschutz.
          </p>
        </div>
        <div>
          <h3 class="mb-4 text-gray-900">Links</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            <li>
              <a href="/begriffsliste/" class="hover:text-gray-900"
                >Begriffsliste</a
              >
            </li>
            <li>
              <a href="#" class="hover:text-gray-900"
                >Schweizerische Brandschutzvorschriften</a
              >
            </li>
            <li>
              <a
                href="https://www.bsvonline.ch/de"
                target="_blank"
                class="hover:text-gray-900"
                >Vereinung Kantonaler Feuerversicherungen VKF</a
              >
            </li>
          </ul>
        </div>
        <div>
          <h3 class="mb-4 text-gray-900">Sprachen</h3>
          <ul class="space-y-2">
            {
              languages.map((lang) => (
                <li>
                  <a
                    href={getLocaleUrl(currentPath, lang.code)}
                    class="flex items-center gap-2"
                  >
                    <div set:html={lang.flag} class="w-4 h-3" />
                    <span class="text-sm text-gray-600 capitalize">
                      {lang.name}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
    <div
      class="border-t pt-6 mt-8 text-center text-sm text-gray-500 border-gray-200"
    >
      © 2026 Vereinigung Kantonaler Feuerversicherungen (VKF)
    </div>
  </div>
</footer>
